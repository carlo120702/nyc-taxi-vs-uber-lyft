          "rawSql": "SELECT service, sum(wait_min_sum) / nullif(sum(wait_trips), 0) AS avg_wait_min, sum(driver_pay_sum) / nullif(sum(fare_sum), 0) AS driver_pay_share_of_fare FROM service_month_kpi WHERE make_date(year, month, 1) BETWEEN $__timeFrom() AND $__timeTo() AND source = 'fhvhv' GROUP BY service"
