    {
      "id": 9,
      "title": "Base fare per mile (USD)",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nyctaxi-rds"
      },
      "description": "Fare before tips, taxes and surcharges divided by miles travelled.",
      "gridPos": {
