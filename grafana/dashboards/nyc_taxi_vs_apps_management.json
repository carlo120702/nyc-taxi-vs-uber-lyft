          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT zone, borough, sum(trips) AS trips, sum(trips) FILTER (WHERE service = 'Yellow Taxi')::float / sum(trips) AS taxi_share, sum(fare_sum) FILTER (WHERE service = 'Yellow Taxi') / nullif(sum(trips) FILTER (WHERE service = 'Yellow Taxi'), 0) AS taxi_avg_fare, sum(fare_sum) FILTER (WHERE service <> 'Yellow Taxi') / nullif(sum(trips) FILTER (WHERE service <> 'Yellow Taxi'), 0) AS app_avg_fare FROM zone_month_kpi WHERE make_date(year, month, 1) BETWEEN $__timeFrom() AND $__timeTo() GROUP BY zone, borough HAVING sum(trips) >= 50000 ORDER BY taxi_share DESC LIMIT 15"
