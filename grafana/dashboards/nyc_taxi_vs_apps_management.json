          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT service, sum(fare_sum) / nullif(sum(miles_sum), 0) AS fare_per_mile FROM service_month_kpi WHERE make_date(year, month, 1) BETWEEN $__timeFrom() AND $__timeTo() AND service IN ($service) GROUP BY service ORDER BY 2 DESC"
