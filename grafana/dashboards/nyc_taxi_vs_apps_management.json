    {
      "id": 11,
      "title": "Average trip: distance and duration",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nyctaxi-rds"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nyctaxi-rds"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT service, sum(miles_sum) / sum(trips) AS avg_miles, sum(minutes_sum) / sum(trips) AS avg_minutes, sum(miles_sum) / nullif(sum(minutes_sum) / 60, 0) AS avg_speed_mph, sum(airport_trips)::float / sum(trips) AS airport_share, sum(cbd_trips)::float / sum(trips) AS cbd_toll_share FROM service_month_kpi WHERE make_date(year, month, 1) BETWEEN $__timeFrom() AND $__timeTo() AND service IN ($service) GROUP BY service ORDER BY sum(trips) DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "avg_.*"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 12,
