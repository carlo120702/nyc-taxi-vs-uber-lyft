# Copy this file to ".env" and fill in the values of your AWS RDS instance.
# ".env" is listed in .gitignore and must NEVER be pushed to GitHub.
DB_HOST=your-instance.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=nyctaxi
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSLMODE=require

# Analysis period and default Dask configuration (A was 35 % faster in the benchmark)
START_YEAR=2025
END_YEAR=2025
DASK_CONFIG=A_2workers_6GB
